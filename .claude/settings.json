{
  "permissions": {
    "deny": [
      "Read(~/.config/investor-os/**)",
      "Edit(~/.config/investor-os/**)",
      "Bash(*telegram.env*)",
      "Bash(*.config/investor-os*)",
      "Edit(/Rules/**)",
      "Edit(/rules/**)",
      "Edit(/rules.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/CLAUDE.local.md)",
      "Edit(/Portfolio/**)",
      "Edit(/portfolio/**)",
      "Edit(/sensors/base/model.py)",
      "Edit(/sensors/strategic/model.py)",
      "Edit(/sensors/valuation/save.py)",
      "Edit(/sensors/valuation/runs/**)",
      "Edit(/sensors/alerts/alertmap.py)",
      "Edit(/sensors/guardrails/*.py)",
      "Edit(/sensors/guardrails/*.json)",
      "Edit(/.claude/**)",
      "Edit(/.mcp.json)",
      "Edit(~/.claude/settings*.json)",
      "Edit(~/.claude/hooks/**)",
      "Edit(~/.claude/agents/**)",
      "Edit(~/.claude/skills/**)",
      "Edit(~/.claude/scheduled-tasks/**)",
      "Bash(*alpaca*)",
      "Bash(*ibkr*)",
      "Bash(*interactivebrokers*)",
      "Bash(*ib_insync*)",
      "Bash(*ib_async*)",
      "Bash(*ibapi*)",
      "Bash(*robin_stocks*)",
      "Bash(*robinhood*)",
      "Bash(*tradestation*)",
      "Bash(*tastytrade*)",
      "Bash(*webull*)",
      "Bash(*tradier*)",
      "Bash(*schwab.com*)",
      "Bash(*schwabapi*)",
      "Bash(*schwab-py*)",
      "Bash(*fidelity.com*)",
      "Bash(*vanguard.com*)",
      "Bash(*etrade.com*)",
      "Bash(*pyetrade*)",
      "Bash(*tdameritrade*)",
      "Bash(*place_order*)",
      "Bash(*placeOrder*)",
      "Bash(*submit_order*)",
      "Bash(*submitOrder*)",
      "Bash(*cancel_order*)",
      "Bash(*cancelOrder*)",
      "Bash(*owner-apply*)",
      "PowerShell(*alpaca*)",
      "PowerShell(*ibkr*)",
      "PowerShell(*interactivebrokers*)",
      "PowerShell(*robinhood*)",
      "PowerShell(*schwab.com*)",
      "PowerShell(*fidelity.com*)",
      "PowerShell(*etrade.com*)",
      "PowerShell(*place_order*)",
      "PowerShell(*placeOrder*)",
      "PowerShell(*submit_order*)",
      "PowerShell(*owner-apply*)",
      "WebFetch(domain:alpaca.markets)",
      "WebFetch(domain:*.alpaca.markets)",
      "WebFetch(domain:interactivebrokers.com)",
      "WebFetch(domain:*.interactivebrokers.com)",
      "WebFetch(domain:ibkr.com)",
      "WebFetch(domain:*.ibkr.com)",
      "WebFetch(domain:schwab.com)",
      "WebFetch(domain:*.schwab.com)",
      "WebFetch(domain:fidelity.com)",
      "WebFetch(domain:*.fidelity.com)",
      "WebFetch(domain:vanguard.com)",
      "WebFetch(domain:*.vanguard.com)",
      "WebFetch(domain:robinhood.com)",
      "WebFetch(domain:*.robinhood.com)",
      "WebFetch(domain:etrade.com)",
      "WebFetch(domain:*.etrade.com)",
      "WebFetch(domain:tradestation.com)",
      "WebFetch(domain:*.tradestation.com)",
      "WebFetch(domain:tastytrade.com)",
      "WebFetch(domain:*.tastytrade.com)",
      "WebFetch(domain:webull.com)",
      "WebFetch(domain:*.webull.com)",
      "WebFetch(domain:tradier.com)",
      "WebFetch(domain:*.tradier.com)",
      "WebFetch(domain:moomoo.com)",
      "WebFetch(domain:*.moomoo.com)",
      "WebFetch(domain:futunn.com)",
      "WebFetch(domain:*.futunn.com)",
      "mcp__computer-use",
      "mcp__claude-in-chrome",
      "mcp__Claude_Browser",
      "mcp__remote-devices"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {"matcher": "*", "hooks": [{"type": "command", "onFailure": "block", "command": "P=$(command -v python3 || command -v python || command -v py) || { echo 'guardrails: no Python, so this call is blocked' >&2; exit 2; }; \"$P\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/guardrails.py\"; rc=$?; [ $rc -eq 0 ] || exit 2"}]}
    ],
    "PostToolUse": [
      {"matcher": "Bash|PowerShell", "hooks": [{"type": "command", "command": "P=$(command -v python3 || command -v python || command -v py) || exit 2; \"$P\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/guardrails.py\"; rc=$?; [ $rc -eq 0 ] || exit 2"}]}
    ],
    "PostToolUseFailure": [
      {"matcher": "Bash|PowerShell", "hooks": [{"type": "command", "command": "P=$(command -v python3 || command -v python || command -v py) || exit 2; \"$P\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/guardrails.py\"; rc=$?; [ $rc -eq 0 ] || exit 2"}]}
    ]
  }
}
